# Copie este arquivo para .env e preencha com os seus dados.
# O .env está no .gitignore e NUNCA deve ser commitado.

# Nome da conta do bot na Twitch
TWITCH_USERNAME=voippbot

# Token OAuth da conta do bot (com ou sem o prefixo "oauth:")
TWITCH_OAUTH_TOKEN=

# Canal onde o bot vai entrar
TWITCH_CHANNEL=voipp_
